# Normalize text in the repo, check out native on Windows
* text=auto

# Anything that runs on the Pi or in a Linux sim must stay LF.
# CRLF here produces "bad interpreter: /bin/sh^M" and cocotb command failures.
*.sh        text eol=lf
*.py        text eol=lf
Makefile    text eol=lf
*.mk        text eol=lf
*.service   text eol=lf

# Windows-native tooling
*.bat       text eol=crlf
*.ps1       text eol=crlf

# Quartus rewrites these; let them be native
*.qsf       text
*.qpf       text
*.sdc       text
*.sv        text
*.v         text

# Binary — never touch
*.sof       binary
*.pof       binary
*.jic       binary
*.npy       binary
*.npz       binary
*.png       binary
*.pdf       binary
*.kicad_pcb text
*.kicad_sch text
